{
  "navigationFallback": {
    "rewrite": "/menu.html"
  },
  "routes": [
    {
      "route": "/*",
      "allowedRoles": ["authenticated"]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/github?post_login_redirect_uri=/menu.html",
      "statusCode": 302
    }
  }
}
